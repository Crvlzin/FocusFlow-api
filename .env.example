# Configurações do Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/focusflow_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_aqui

# Configurações de Segurança e JWT (mínimo de 32 caracteres em produção)
API_SECURITY_TOKEN_SECRET=sua_chave_secreta_jwt_para_geracao_de_tokens
TOKEN_EXPIRATION_HOURS=24

# CORS - Origens permitidas separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://focusflow.vercel.app

# Porta da Aplicação
PORT=8080
